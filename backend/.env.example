# ──────────────────────────────────────────────────────────────────
# ExamEval backend environment.
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# Never commit your real .env — it is gitignored.
# ──────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development           # development | production
PORT=5000
LOG_LEVEL=info                 # error | warn | info | debug

# ── REQUIRED (the server refuses to boot without these) ───────────
# Postgres connection string (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exameval

# JWT secrets — generate strong values:  openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32

# ── RECOMMENDED (features degrade without these) ──────────────────
# Groq LLM API key — get one at https://console.groq.com (starts with gsk_)
GROQ_API_KEY=gsk_your_key_here

# ── Handwriting OCR (optional; pick ONE provider — Gemini preferred) ──────────
# Google AI Studio (Gemini): best handwriting accuracy, reads images AND PDFs.
# Get a FREE key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# OR Groq vision: set a multimodal model id from https://console.groq.com
GROQ_VISION_MODEL=

# If neither is set, scanned/handwritten scripts fall back to Tesseract OCR.

# Redis (BullMQ queue + worker). Defaults to local if unset.
REDIS_URL=redis://localhost:6379

# ── Optional / has sane defaults ──────────────────────────────────
# Access/refresh token lifetimes
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Max parallel Groq calls per evaluation batch (cost/throughput control)
MAX_CONCURRENT_GROQ_CALLS=5

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://exameval-murex.vercel.app

# Local upload directory (dev path)
UPLOAD_DIR=./uploads

# ── File storage / OCR (Cloudinary) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Supabase (optional alternative storage) ───────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
