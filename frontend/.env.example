# ExamEval frontend (Vite). Copy this to `.env`:  cp .env.example .env
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the backend API.
# Local dev (backend on port 5000):
VITE_API_URL=http://localhost:5000/api
# If you serve the frontend behind the same origin as the API, you can use: /api
